#!/bin/sh
# Cache-busting per GitHub Pages.
# GitHub Pages serve assets/* con Cache-Control: max-age=600 e non permette
# di cambiare gli header. Per evitare che un deploy carichi l'HTML nuovo con
# CSS/JS vecchi, ad ogni commit che tocca i file front-end riscriviamo il
# parametro ?v= sugli asset in tutte le pagine HTML (IT ed EN) con un
# timestamp fresco.

pages="index.html en/index.html"

changed=$(git diff --cached --name-only)
echo "$changed" | grep -Eq '^(index\.html|en/index\.html|assets/styles\.css|assets/script\.js)$' || exit 0

ver=$(date +%s)
for page in $pages; do
  [ -f "$page" ] || continue
  tmp=$(mktemp)
  sed -E "s#(assets/(styles\.css|script\.js))\?v=[0-9]+#\1?v=$ver#g" "$page" > "$tmp" && mv "$tmp" "$page"
  git add "$page"
done
